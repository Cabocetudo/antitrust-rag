# Copy to .env and fill in. Never commit .env.
# docker compose reads ANTHROPIC_API_KEY / RAG_* from this file automatically.

# --- Claude (only needed for /ask; /search works without it) ---
ANTHROPIC_API_KEY=
RAG_LLM_MODEL=claude-sonnet-5-5
RAG_LLM_MAX_TOKENS=800
RAG_LLM_TIMEOUT_S=30
RAG_LLM_MAX_RETRIES=3
# Optional price override in USD per million tokens (otherwise the built-in table is used)
# RAG_LLM_PRICE_INPUT_PER_MTOK=2.0
# RAG_LLM_PRICE_OUTPUT_PER_MTOK=10.0

# --- Storage: postgres | memory ---
RAG_STORE=postgres
RAG_DATABASE_URL=postgresql://rag:rag@localhost:5432/antitrust_rag

# --- Embeddings: sentence-transformers | fake ---
RAG_EMBEDDER=sentence-transformers
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_EMBEDDING_DIM=384

# --- Retrieval ---
RAG_TOP_K=6
RAG_CANDIDATE_K=30
RAG_RRF_K=60
RAG_RERANK=false
RAG_RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# --- API ---
RAG_CACHE_TTL_S=600
RAG_LOG_LEVEL=INFO
